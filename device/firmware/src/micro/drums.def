/* The drum parameters, once. D(id, key, max, kind): C continuous 0..max, B bipolar (8192 = centre), E a choice 0..max.
 * The model and its ranges follow the fmdrum voice the drums are ported from (its units: %, its x10 ratios).
 * The kit's values are in drums.c (DKIT). */
D(MODEL,      "model",          4, E)   /* kick, snare, hat, metal, perc */
D(PITCH,      "pitch",        800, C)   /* % of 48 Hz: 10 .. 800 (4.8 .. 384 Hz) */
D(SWEEP,      "sweep",        100, C)   /* the pitch drop: up to 400 Hz above, falling with the square of its envelope */
D(DECAY,      "decay",        127, C)   /* 0..100 as in the original (short), 101..127 longer */
D(OP1_INDEX,  "op1_index",    100, C)   /* operator 1 into the carrier: 0 .. 22.5 radians */
D(OP2_INDEX,  "op2_index",    100, C)   /* operator 2 into operator 1: 0 .. 10 radians */
D(OP1_RATIO,  "op1_ratio",    200, C)   /* x 0.1: 0 .. 20 */
D(OP2_RATIO,  "op2_ratio",    200, C)   /* x 0.1 */
D(FEEDBACK,   "feedback",     100, C)   /* operator 2 on itself */
D(NOISE,      "noise",        100, C)
D(DRIVE,      "drive",        200, C)   /* gain into the drum bus' saturation: x1 .. x11 (100 = the original's top) */
D(LEVEL,      "level",        100, C)
D(PAN,        "pan",        16383, B)
D(REV,        "rev",        16383, C)   /* send to the reverb */
D(DLY,        "dly",        16383, C)   /* send to the delay */
D(CHOKE,      "choke",          2, E)   /* group: drums of the same group cut each other */
D(CLAP,       "clap",           3, E)   /* extra bursts, 8 .. 11 ms apart (uneven, as hands) */
